# Development Environment Configuration
VITE_APP_ENV=development
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_CDN_URL=
VITE_LOG_LEVEL=debug
VITE_ENABLE_ANALYTICS=false
