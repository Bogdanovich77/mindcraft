{
  "name": "mindcraft-cognitive-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=src",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "test:security": "jest --testPathPattern=security",
    "test:integration": "node run_comprehensive_integration_tests.cjs",
    "test:performance": "node test_performance_validation.cjs",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "jest --coverage --watchAll=false --ci",
    "analyze": "npm run build && npx webpack-bundle-analyzer dist/static/js/*.js",
    "lighthouse": "npm run build && npx lighthouse http://localhost:5173 --output=html --output-path=./lighthouse-reports",
    "validate": "npm run test:all && npm run lint && npm run build",
    "validate:quick": "npm run test:unit && npm run lint",
    "build:prod": "chmod +x scripts/build.sh && ./scripts/build.sh build",
    "build:staging": "chmod +x scripts/build.sh && ./scripts/build.sh build --env=staging",
    "build:dev": "chmod +x scripts/build.sh && ./scripts/build.sh build --skip-tests",
    "deploy:staging": "chmod +x scripts/build.sh && ./scripts/build.sh deploy-staging",
    "deploy:prod": "chmod +x scripts/build.sh && ./scripts/build.sh deploy-production",
    "docker:build": "docker build -t mindcraft-frontend .",
    "docker:run": "docker run -p 8080:8080 --env-file .env.production mindcraft-frontend",
    "docker:compose:up": "docker-compose -f docker-compose.yml up -d",
    "docker:compose:down": "docker-compose -f docker-compose.yml down",
    "docker:compose:logs": "docker-compose -f docker-compose.yml logs -f",
    "health:check": "chmod +x docker-healthcheck.sh && ./docker-healthcheck.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.15.21",
    "@mui/material": "^5.15.21",
    "@mui/styled-engine": "^5.15.21",
    "@mui/x-charts": "^7.23.6",
    "@reduxjs/toolkit": "^2.2.8",
    "axios": "^1.7.9",
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "babel-jest": "^29.7.0",
    "cypress": "^13.17.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lodash": "^4.17.21",
    "react-devtools": "^7.0.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.15.21",
    "@mui/icons-material": "^5.15.21"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.(ts|tsx|js|jsx)",
      "<rootDir>/src/**/*.test.(ts|tsx|js|jsx)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/",
      "<rootDir>/test/mocks/"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.(ts|tsx|js|jsx)",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "maxWorkers": "50%",
    "testTimeout": 10000,
    "clearMocks": true,
    "restoreMocks": true,
    "resetMocks": true
  },
  "cypress": {
    "component": {
      "devServer": {
        "framework": "react",
        "bundler": "vite"
      }
    },
    "e2e": {
      "supportFile": "cypress/support/e2e.ts",
      "specPattern": "cypress/e2e/**/*.cy.{js,jsx,ts,tsx}",
      "video": true,
      "screenshotOnRunFailure": true,
      "defaultCommandTimeout": 10000,
      "requestTimeout": 10000,
      "responseTimeout": 10000,
      "pageLoadTimeout": 10000
    }
  }
}
