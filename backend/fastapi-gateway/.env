# FastAPI Gateway Environment Configuration
# This file contains configuration for the FastAPI gateway service

# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=false

# Node.js Agent Core Configuration
NODE_CORE_HOST=localhost
NODE_CORE_PORT=8081

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Security Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging Configuration
LOG_LEVEL=INFO

# WebSocket Configuration
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100

# HTTP Client Configuration
HTTP_TIMEOUT=30
HTTP_RETRY_ATTEMPTS=3

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_EVENTS_PER_MINUTE=100